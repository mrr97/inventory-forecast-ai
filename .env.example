# Copy to .env and adjust. Every value has a working default — the project runs
# end to end with no .env at all (`docker compose up`). Override only what you need.

# Synthetic demo dataset (reproducible by seed)
DEMO_SEED=42
DEMO_SKU_COUNT=22

# CatBoost compute device. "CPU" is the portable, deterministic default. For very
# large catalogues (hundreds of thousands of SKUs) set "GPU" to train on CUDA with
# no other code change. See the README "Scaling note".
CATBOOST_TASK_TYPE=CPU

# MLflow experiment tracking (local SQLite backend, no server)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=demand-forecast

# Rolling-origin backtest (train on all but the last N days, roll the origin through them)
BACKTEST_HOLDOUT_DAYS=120

# Multi-objective optimization (NSGA-II). The planning horizon is fixed at the protection
# interval in forecasting.features.HORIZON, so it is not configured here.
OPT_SCENARIOS=50
OPT_POP_SIZE=80
OPT_GENERATIONS=60
OPT_SEED=42
# Optional shared cap on average inventory investment (EUR). Empty = unconstrained.
# INVENTORY_BUDGET=

# Dash dashboard
UI_HOST=127.0.0.1
UI_PORT=8050

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false
